# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- PostgreSQL container (docker-compose reads these) ---
POSTGRES_DB=pickup_pro
POSTGRES_USER=pickup_user
POSTGRES_PASSWORD=change-me-locally

# --- Application ---
# One of: development | testing | production
APP_ENV=development

# Signs the session cookie. A known value lets anyone forge a login, so this is
# NOT optional in production -- ProductionConfig refuses to boot on a placeholder.
# Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://pickup_user:change-me-locally@127.0.0.1:5432/pickup_pro
# Optional. Defaults to DATABASE_URL with "_test" appended.
TEST_DATABASE_URL=

# --- Redis (caching and rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
