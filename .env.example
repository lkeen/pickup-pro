# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- PostgreSQL container (docker-compose reads these) ---
POSTGRES_DB=pickup_pro
POSTGRES_USER=pickup_user
POSTGRES_PASSWORD=change-me-locally

# --- Application ---
# One of: development | testing | production
APP_ENV=development

# Wall-clock times (a game's start) are interpreted and displayed in this zone;
# everything is stored in UTC. Any IANA name, e.g. America/New_York.
APP_TIMEZONE=UTC

# Signs the session cookie. A known value lets anyone forge a login, so this is
# NOT optional in production -- ProductionConfig refuses to boot on a placeholder.
# Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://pickup_user:change-me-locally@127.0.0.1:5432/pickup_pro
# Optional. Defaults to DATABASE_URL with "_test" appended.
TEST_DATABASE_URL=

# --- Redis (caching and rate limiting) ---
REDIS_URL=redis://localhost:6379/0
# Tests use a separate database so a run cannot evict development entries.
TEST_REDIS_URL=redis://localhost:6379/15

# --- Google OAuth (optional) ---
# Leave blank to run without it: the "Continue with Google" button simply does
# not render and /auth/google returns 404.
#
# To enable:
#   1. https://console.cloud.google.com/apis/credentials -> Create credentials
#      -> OAuth client ID -> Web application
#   2. Authorized redirect URI: http://localhost:5000/auth/callback
#   3. Consent screen may stay in "Testing" mode; add your own account as a
#      test user. No Google verification review is needed for that.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reverse proxy ---
# How many proxies sit in front of the app. 0 means it is exposed directly and
# client-supplied X-Forwarded-* headers are ignored -- trusting them without a
# proxy lets any client claim any IP address, which defeats rate limiting.
# Production defaults to 1; set it to match your deployment.
TRUSTED_PROXY_HOPS=0

# --- Connection pool (per worker process) ---
# The ceiling is (DB_POOL_SIZE + DB_MAX_OVERFLOW) x gunicorn workers, which has
# to stay under the server's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- HSTS (production only) ---
# Seconds browsers should refuse to load this site over plain HTTP. Only set a
# long value once HTTPS is known to work, since it is hard to walk back.
HSTS_SECONDS=31536000
